{
  "name": "motionex",
  "version": "0.1.0",
  "private": true,
  "description": "Bare motion-graphics tools for AI agents in one service: voice (Piper), picture capture, music (Mucavex/Strudel), SFX synthesis, mixing, loudness, encoding",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mx": "bin/mx.mjs"
  },
  "scripts": {
    "serve": "node bin/mx.mjs serve",
    "test": "node scripts/test.mjs default",
    "lint": "biome check ."
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@strudel/core": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/soundfonts": "1.3.0",
    "@strudel/tonal": "1.2.6",
    "@strudel/transpiler": "1.2.6",
    "@strudel/webaudio": "1.3.0",
    "ajv": "8.20.0",
    "gsap": "3.15.1",
    "node-web-audio-api": "2.2.0",
    "playwright-core": "1.65.0",
    "superdough": "1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "3.1.0"
  }
}
