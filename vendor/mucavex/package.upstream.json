{
  "name": "mucavex",
  "version": "0.1.0",
  "private": true,
  "description": "Headless Strudel renderer: Strudel code in, WAV out",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mucavex": "src/cli.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "render": "node src/cli.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@strudel/core": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/soundfonts": "1.3.0",
    "@strudel/tonal": "1.2.6",
    "@strudel/transpiler": "1.2.6",
    "@strudel/webaudio": "1.3.0",
    "node-web-audio-api": "2.2.0",
    "superdough": "1.3.0"
  }
}
