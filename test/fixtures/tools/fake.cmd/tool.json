{
  "name": "fake.cmd",
  "version": "1.0.0",
  "title": "fake.cmd",
  "summary": "Test tool: a command tool speaking the JSONL protocol.",
  "kind": "command",
  "command": ["${MX_NODE}", "cmd.mjs"],
  "deterministic": true,
  "cache_default": "auto",
  "resources": {
    "class": "light",
    "slots": 0
  },
  "timeout_s": 60,
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["message"],
    "properties": {
      "message": {
        "type": "string",
        "description": "Echoed back; written to out/msg.txt."
      },
      "fail": {
        "type": "boolean",
        "default": false,
        "description": "Emit a protocol error line instead of a result."
      },
      "crash": {
        "type": "boolean",
        "default": false,
        "description": "Exit 2 without a result line."
      }
    }
  },
  "examples": [
    {
      "title": "echo",
      "input": {
        "message": "hello ünïcödé ʃˈɒp"
      }
    },
    {
      "title": "protocol round trip",
      "input": {
        "message": "ünï ʃˈɒp"
      },
      "fixtures": {}
    }
  ]
}
